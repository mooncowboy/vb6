@model BookManagerWeb.Models.BookInfo
@{
    ViewData["Title"] = "Book Details";
}

<div class="container mt-4">
    <h2>Book Details</h2>
    
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Browse", "Books")">
                    <i class="bi bi-house"></i> Browse
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-book"></i> @Model.Title
                    </h5>
                    <a href="@Url.Action("Edit", new { path = Model.Directory })" 
                       class="btn btn-sm btn-warning">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th style="width: 30%">Directory</th>
                                <td>@Model.Directory</td>
                            </tr>
                            <tr>
                                <th>Title (书名)</th>
                                <td>@Model.Title</td>
                            </tr>
                            <tr>
                                <th>Author (作者)</th>
                                <td>@Model.Author</td>
                            </tr>
                            <tr>
                                <th>SS ID (SS号)</th>
                                <td>@Model.SsId</td>
                            </tr>
                            <tr>
                                <th>Publisher (出版社)</th>
                                <td>@Model.Publisher</td>
                            </tr>
                            <tr>
                                <th>Publish Date (出版日期)</th>
                                <td>@Model.PublishDate</td>
                            </tr>
                            <tr>
                                <th>Pages (页数)</th>
                                <td>@Model.PagesCount</td>
                            </tr>
                            <tr>
                                <th>Subject (主题)</th>
                                <td>@Model.Subject</td>
                            </tr>
                            @if (!string.IsNullOrEmpty(Model.Comments))
                            {
                                <tr>
                                    <th>Comments (备注)</th>
                                    <td>@Model.Comments</td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.Url))
                            {
                                <tr>
                                    <th>URL (地址)</th>
                                    <td><a href="@Model.Url" target="_blank">@Model.Url</a></td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.Downloader))
                            {
                                <tr>
                                    <th>Downloader (下载人)</th>
                                    <td>@Model.Downloader</td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.DownloadDate))
                            {
                                <tr>
                                    <th>Download Date (下载日期)</th>
                                    <td>@Model.DownloadDate</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            @if (Model.HasCover)
            {
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-image"></i> Cover
                        </h5>
                    </div>
                    <div class="card-body text-center">
                        @if (Model.CoverImagePath.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase))
                        {
                            <img src="file://@Model.CoverImagePath" 
                                 alt="Book Cover" 
                                 class="img-fluid" 
                                 style="max-height: 400px;" />
                        }
                        else
                        {
                            <p class="text-muted">
                                <i class="bi bi-file-earmark-image"></i><br/>
                                Cover file: @System.IO.Path.GetFileName(Model.CoverImagePath)<br/>
                                <small>(PDG format cannot be displayed in browser)</small>
                            </p>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-body text-center text-muted">
                        <i class="bi bi-image" style="font-size: 3rem;"></i>
                        <p>No cover image available</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a href="@Url.Action("Browse", new { path = System.IO.Path.GetDirectoryName(Model.Directory) })" 
           class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Browse
        </a>
    </div>
</div>
