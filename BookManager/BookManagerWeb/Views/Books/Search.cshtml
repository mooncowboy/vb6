@model dynamic
@{
    ViewData["Title"] = "Search Books";
    var books = ViewBag.Books as List<BookManagerWeb.Models.FolderItem>;
    var rootPath = ViewBag.RootPath as string;
}

<div class="container mt-4">
    <h2>Search Books</h2>
    
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Search" method="get">
                <div class="row">
                    <div class="col-md-10">
                        <input type="text" 
                               name="rootPath" 
                               class="form-control" 
                               placeholder="Enter root path to search (e.g., C:\Books)" 
                               value="@rootPath" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                </div>
                <small class="form-text text-muted">
                    This will search for directories containing bookinfo.dat files up to 2 levels deep.
                </small>
            </form>
        </div>
    </div>

    @if (books != null && books.Any())
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-book"></i> Found @books.Count book(s)
                </h5>
            </div>
            <div class="card-body">
                <div class="list-group">
                    @foreach (var book in books)
                    {
                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">
                                        <i class="bi bi-folder"></i> @book.Name
                                        <span class="badge bg-success ms-2">
                                            <i class="bi bi-book"></i> Book
                                        </span>
                                    </h6>
                                    <small class="text-muted">@book.Path</small><br/>
                                    <small class="text-muted">
                                        Last modified: @book.LastModified?.ToString("yyyy-MM-dd HH:mm:ss")
                                    </small>
                                </div>
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("Details", new { path = book.Path })" 
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-info-circle"></i> Details
                                    </a>
                                    <a href="@Url.Action("Edit", new { path = book.Path })" 
                                       class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(rootPath))
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No books found in the specified path.
        </div>
    }

    <div class="mt-3">
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
    </div>
</div>
