@model BookManagerWeb.Models.BookInfo
@{
    ViewData["Title"] = "Edit Book";
}

<div class="container mt-4">
    <h2>Edit Book Information</h2>
    
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Browse", "Books")">
                    <i class="bi bi-house"></i> Browse
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="@Url.Action("Details", new { path = Model.Directory })">@Model.Title</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
    </nav>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-pencil"></i> Edit Book Metadata
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Directory" />
                
                <div class="mb-3">
                    <label class="form-label">Directory (Readonly)</label>
                    <input type="text" class="form-control" value="@Model.Directory" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Title (书名)</label>
                    <input asp-for="Title" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Author" class="form-label">Author (作者)</label>
                    <input asp-for="Author" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="SsId" class="form-label">SS ID (SS号)</label>
                    <input asp-for="SsId" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Publisher" class="form-label">Publisher (出版社)</label>
                    <input asp-for="Publisher" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="PublishDate" class="form-label">Publish Date (出版日期)</label>
                    <input asp-for="PublishDate" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="PagesCount" class="form-label">Pages Count (页数)</label>
                    <input asp-for="PagesCount" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="StartPage" class="form-label">Start Page (起始页)</label>
                    <input asp-for="StartPage" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Subject" class="form-label">Subject (主题)</label>
                    <input asp-for="Subject" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Comments" class="form-label">Comments (备注)</label>
                    <textarea asp-for="Comments" class="form-control" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="IsJpgBook" class="form-label">Is JPG Book (是JPG书)</label>
                    <input asp-for="IsJpgBook" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="PageUrl" class="form-label">Page URL (页面地址)</label>
                    <input asp-for="PageUrl" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Url" class="form-label">URL (地址)</label>
                    <input asp-for="Url" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="SsUrl" class="form-label">SS URL (SS地址)</label>
                    <input asp-for="SsUrl" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="JpgUrl" class="form-label">JPG URL (JPG地址)</label>
                    <input asp-for="JpgUrl" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="IeJpgUrl" class="form-label">IE JPG URL (IEJPG地址)</label>
                    <input asp-for="IeJpgUrl" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Params" class="form-label">Parameters (参数)</label>
                    <input asp-for="Params" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="SavedIn" class="form-label">Saved In (保存在)</label>
                    <input asp-for="SavedIn" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Header" class="form-label">Header (书名号)</label>
                    <input asp-for="Header" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Downloader" class="form-label">Downloader (下载人)</label>
                    <input asp-for="Downloader" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="DownloadDate" class="form-label">Download Date (下载日期)</label>
                    <input asp-for="DownloadDate" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="HtmlContent" class="form-label">HTML Content (HTML内容)</label>
                    <textarea asp-for="HtmlContent" class="form-control" rows="5"></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                    <a href="@Url.Action("Details", new { path = Model.Directory })" 
                       class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
